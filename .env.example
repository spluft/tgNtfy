# tgNtfy environment — copy to .env and fill in REAL values locally. Never commit real secrets.

# Telegram bot token from BotFather. REQUIRED for the server (admin CLI does not need it).
# TG_BOT_TOKEN=

# Telegram Bot API base URL override — used to point tests at a mock server. Leave empty in production.
# TG_API_URL=

# HTTP listener address (ingest + /api/health + /metrics). Default :8080
# LISTEN_ADDR=:8080

# SQLite database file (mounted volume /data). Default /data/tgntfy.db
# DB_PATH=/data/tgntfy.db

# Path to the events.yaml catalog. Default /etc/tgntfy/events.yaml
# CATALOG_PATH=/etc/tgntfy/events.yaml

# Coalesce window in milliseconds. Default 5000 (5 s per SPEC §8).
# COALESCE_WINDOW_MS=5000

# Optional token for the /api/health 200/401 convention. Empty = open.
# Requires X-Admin-Token header when set.
# ADMIN_TOKEN=

# Log format: json | text. Default json.
# LOG_FORMAT=json

# Log level: info | debug. Default info.
# LOG_LEVEL=info
